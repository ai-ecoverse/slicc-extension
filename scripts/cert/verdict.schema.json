{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "head", "verdict", "summary", "comments"],
  "properties": {
    "schema": { "const": "cert-review/v2" },
    "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "verdict": { "enum": ["pass", "fail"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
    "comments": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "side", "severity", "body"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 300 },
          "line": { "type": "integer", "minimum": 1 },
          "side": { "enum": ["RIGHT", "LEFT"] },
          "severity": { "enum": ["fail", "known", "note"] },
          "body": { "type": "string", "minLength": 1, "maxLength": 1500 }
        }
      }
    }
  }
}
