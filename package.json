{
  "name": "slicc-extension",
  "version": "0.0.0",
  "private": true,
  "description": "SLICC Chrome MV3 extension that lifts CORS for sliccy.ai pages",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-extension.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "pack": "node scripts/pack.mjs",
    "pretest": "playwright-core install --no-shell chromium",
    "test": "node --test --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs test/integration/*.test.mjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "1.4.1",
    "@biomejs/biome": "2.5.15",
    "@semantic-release/exec": "7.1.0",
    "lefthook": "2.1.16",
    "playwright-core": "1.63.0",
    "semantic-release": "25.0.9"
  }
}
