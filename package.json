{
  "name": "slicc-extension",
  "version": "0.0.0",
  "private": true,
  "description": "SLICC Chrome MV3 extension that lifts CORS for sliccy.ai origins",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-extension.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "pack": "node scripts/pack.mjs",
    "test": "npm run pack",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "1.3.0",
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.16",
    "semantic-release": "25.0.9"
  }
}
