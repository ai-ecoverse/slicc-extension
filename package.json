{
  "name": "slicc-extension",
  "version": "0.0.0",
  "private": true,
  "description": "SLICC Chrome MV3 extension that lifts CORS for sliccy.ai pages",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-extension.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint",
    "typecheck": "tsc -p tsconfig.json",
    "format": "biome check --write .",
    "build": "node scripts/build-seven.mjs && node scripts/build-six.mjs",
    "pack": "node scripts/build-seven.mjs && node scripts/build-six.mjs && node scripts/pack.mjs",
    "pretest": "npm run build && slicc-cdp install-browser",
    "test": "node --test --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs test/integration/*.test.mjs",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "release": "semantic-release",
    "test:six": "vitest run"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-browsers": "1.18.6",
    "@ai-ecoverse/slicc-cdp": "1.31.1",
    "@ai-ecoverse/slicc-shared-web": "2.9.0",
    "@biomejs/biome": "2.5.15",
    "@semantic-release/exec": "7.1.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@ai-ecoverse/cherry": "6.250.1"
  },
  "slicc": {
    "unitSources": [
      "extension",
      "scripts",
      "six"
    ]
  }
}
