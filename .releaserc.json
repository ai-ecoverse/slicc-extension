{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "node scripts/check-six-version.mjs",
        "prepareCmd": "node scripts/pack.mjs ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "artifacts/slicc-extension.zip",
            "label": "Chrome MV3 extension (zip)"
          }
        ]
      }
    ]
  ]
}
