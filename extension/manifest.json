{
  "manifest_version": 3,
  "name": "slicc",
  "version": "0.0.0",
  "description": "Lifts CORS for SLICC pages on sliccy.ai, so they reach the whole web, and bridges the Chrome debugger to them.",
  "key": "",
  "minimum_chrome_version": "140",
  "permissions": ["declarativeNetRequestWithHostAccess", "identity", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.sliccy.ai/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.sliccy.ai/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "cors", "enabled": true, "path": "rules.json" }]
  },
  "action": {
    "default_title": "slicc"
  }
}
